# URL Portal LMS Operator
LMS_URL=https://lms.contoh-kampus.ac.id/login

# Kredensial Akun Operator LMS
LMS_USERNAME=operator_lms
LMS_PASSWORD=rahasia_operator

# Mode Browser: false untuk menampilkan browser (bagus saat awal/debugging), true untuk jalan di latar belakang (background)
HEADLESS=false

# Lokasi File Jadwal Perkuliahan
DATA_FILE=data/jadwal_zoom.xlsx

# Konfigurasi n8n (Jika menggunakan n8n Execute Command)
NODES_EXCLUDE=[]

# Notifikasi Telegram Bot (Laporan Harian Otomatis)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=987654321
